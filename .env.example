# Copy to .env and fill in from YOUR Supabase project:
# Dashboard -> Project Settings -> API (or the "Connect" button)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon / publishable key. It is safe to ship in the app because Row Level
# Security (supabase/schema.sql) controls what it can access.
# NEVER put the service_role / secret key here.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: your own Sentry project's DSN. Leave empty to disable Sentry.
EXPO_PUBLIC_SENTRY_DSN=
