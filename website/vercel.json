{
    "$schema":  "https://openapi.vercel.sh/vercel.json",
    "cleanUrls":  true,
    "headers":  [
                    {
                        "source":  "/admin/(.*)",
                        "headers":  [
                                        {
                                            "key":  "X-Robots-Tag",
                                            "value":  "noindex, nofollow"
                                        },
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "no-store"
                                        }
                                    ]
                    },
                    {
                        "source":  "/admin",
                        "headers":  [
                                        {
                                            "key":  "X-Robots-Tag",
                                            "value":  "noindex, nofollow"
                                        }
                                    ]
                    },
                    {
                        "source":  "/(.*)",
                        "headers":  [
                                        {
                                            "key":  "X-Content-Type-Options",
                                            "value":  "nosniff"
                                        },
                                        {
                                            "key":  "Referrer-Policy",
                                            "value":  "strict-origin-when-cross-origin"
                                        }
                                    ]
                    }
                ],
    "redirects":  [
                      {
                          "destination":  "/admin/",
                          "permanent":  true,
                          "source":  "/admin"
                      },
                      {
                          "source":  "/download",
                          "destination":  "https://expo.dev/artifacts/eas/1J6CUZ8zUm7AWm-5ddbsA4M7vWAKcpAT3kbEL6OyEcA.apk",
                          "permanent":  false
                      }
                  ]
}