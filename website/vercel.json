{
    "$schema":  "https://openapi.vercel.sh/vercel.json",
    "cleanUrls":  true,
    "headers":  [
                    {
                        "source":  "/admin/(.*)",
                        "headers":  [
                                        {
                                            "key":  "X-Robots-Tag",
                                            "value":  "noindex, nofollow"
                                        },
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "no-store"
                                        }
                                    ]
                    },
                    {
                        "source":  "/admin",
                        "headers":  [
                                        {
                                            "key":  "X-Robots-Tag",
                                            "value":  "noindex, nofollow"
                                        }
                                    ]
                    },
                    {
                        "source":  "/(.*)",
                        "headers":  [
                                        {
                                            "key":  "X-Content-Type-Options",
                                            "value":  "nosniff"
                                        },
                                        {
                                            "key":  "Referrer-Policy",
                                            "value":  "strict-origin-when-cross-origin"
                                        }
                                    ]
                    }
                ],
    "redirects":  [
                      {
                          "destination":  "/admin/",
                          "permanent":  true,
                          "source":  "/admin"
                      },
                      {
                          "source":  "/download",
                          "destination":  "https://expo.dev/artifacts/eas/yCfsy50LQtqvf3vMyaPuAK0uHW3yZNNj2iu0varZKEI.apk",
                          "permanent":  false
                      },
                      {
                          "source":  "/affiliates",
                          "destination":  "https://expo.dev/artifacts/eas/VpDn9hKUiRNLBiAFdR-_qtnoyFBeQgAWQ5Pf19C5Lcw.apk",
                          "permanent":  false
                      }
                  ],
    "rewrites":  [
                     {
                         "source":  "/r/:code",
                         "destination":  "/r"
                     }
                 ]
}